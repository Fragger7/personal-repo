# GEMINI_API_KEY: Required for Gemini AI API calls.
# AI Studio automatically injects this at runtime from user secrets.
# Users configure this via the Secrets panel in the AI Studio UI.
GEMINI_API_KEY="MY_GEMINI_API_KEY"

# APP_URL: The URL where this applet is hosted.
# AI Studio automatically injects this at runtime with the Cloud Run service URL.
# Used for self-referential links, OAuth callbacks, and API endpoints.
APP_URL="MY_APP_URL"

# Telegram Bot Push Alerts (100% Free & Instant)
TELEGRAM_BOT_TOKEN=""
TELEGRAM_CHAT_ID=""
VERCEL_DASHBOARD_URL="https://ws-deal-hunter.vercel.app"
STREAMLIT_DASHBOARD_URL="https://wsdealhunter.streamlit.app/"
HEARTBEAT_INTERVAL_CYCLES="6"  # Periodic reassurance heartbeat every N cycles/hours (e.g. 3 or 6)

# Pushover Mobile Push Alerts (Optional / Configurable)
PUSHOVER_USER_KEY=""
PUSHOVER_API_TOKEN=""

# eBay Browse API Credentials (Optional OAuth2 Client Credentials)
EBAY_CLIENT_ID=""
EBAY_CLIENT_SECRET=""

# Reddit User-Agent Header (Optional custom string)
REDDIT_USER_AGENT="WorkstationDealHunter/1.0 (by /u/DealHunterBot)"

# GitHub Integration
GITHUB_PAT=""
GITHUB_REPO="Fragger7/personal-repo"

